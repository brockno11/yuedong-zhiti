# ============================================================
# 跃动智体 — 环境变量配置模板
# ⚠️ 安全警告：此文件仅供配置参考，不得提交真实的 API Key！
#    真实密钥请写入 .env.local（已在 .gitignore 中）。
# ============================================================

# DeepSeek API Key（可选，不配置则自动使用内置 Mock 数据）
# 获取地址: https://platform.deepseek.com/
# ⚠️ 请勿将真实 Key 提交到 Git 仓库
DEEPSEEK_API_KEY=

# SQLite 本地数据库（Prisma）
DATABASE_URL="file:./dev.db"

# DeepSeek API Base URL（通常无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# AI 模型选择: deepseek-chat（通用）或 deepseek-v4-flash（快速）
DEEPSEEK_MODEL=deepseek-chat

# AI 请求超时（毫秒），超时后自动回退 Mock 数据
AI_REQUEST_TIMEOUT_MS=12000
